# Torn API key. Public/Limited access is enough for faction member status.
TORN_API_KEY=your16charapikey

# Your faction ID (number)
OWN_FACTION_ID=12345

# Enemy faction ID. Leave blank to auto-detect from active ranked war.
ENEMY_FACTION_ID=

# Discord webhook that gets pinged when an ENEMY is ~1 min from leaving hospital
DISCORD_WEBHOOK_ENEMY=https://discord.com/api/webhooks/xxxx/yyyy

# Discord webhook that gets pinged when an ALLY is ~1 min from leaving hospital
DISCORD_WEBHOOK_ALLY=https://discord.com/api/webhooks/xxxx/yyyy

# Optional: Discord role ID to @mention on enemy call-outs (e.g. "Hitters")
DISCORD_ENEMY_ROLE_ID=

# How often to poll the Torn API, in milliseconds. 10000-15000 is safe.
POLL_INTERVAL_MS=10000

# Warn when a player has this many seconds or fewer left in hospital
WARN_WINDOW_SECONDS=60

# Optional: map Torn user IDs to Discord user IDs for direct @mentions on ally alerts.
# JSON string: {"1234567":"9876543210","2345678":"1122334455"}
DISCORD_ID_MAP={}
